{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/%D7%95%D7%99%D7%93%D7%99%D7%90%D7%95-%D7%9E%D7%97%D7%95%D7%93%D7%A9",
      "destination": "/podcast",
      "permanent": true
    },
    {
      "source": "/%D7%94%D7%AA%D7%A7%D7%A4%D7%94-%D7%9E%D7%AA%D7%A4%D7%A8%D7%A6%D7%AA",
      "destination": "/programs/fast-break",
      "permanent": true
    },
    {
      "source": "/%D7%9E%D7%92%D7%A8%D7%A9-%D7%9E%D7%A1%D7%9B%D7%9D",
      "destination": "/programs/court-summary",
      "permanent": true
    },
    {
      "source": "/%D7%A4%D7%A6%D7%A6%D7%94-%D7%91%D7%99%D7%A6%D7%99%D7%A2",
      "destination": "/programs/stands",
      "permanent": true
    },
    {
      "source": "/%D7%9E%D7%A6%D7%98%D7%99%D7%99%D7%A0%D7%95%D7%AA-%D7%94%D7%A9%D7%A0%D7%94-2026",
      "destination": "/awards",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/articles",
      "permanent": true
    },
    {
      "source": "/about-1",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/services-4-1",
      "destination": "/programs",
      "permanent": true
    },
    {
      "source": "/post/:slug",
      "destination": "/articles/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(app.js|app.css|data.js|seo.js|articles-data.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}